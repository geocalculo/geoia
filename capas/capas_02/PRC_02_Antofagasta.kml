  <Placemark id="prc_antofagasta_mono.536">
	<Style><LineStyle><color>ff0000ff</color></LineStyle><PolyStyle><fill>0</fill></PolyStyle></Style>
	<ExtendedData><SchemaData schemaUrl="#prc_antofagasta_mono">
		<SimpleData name="REG">Antofagasta</SimpleData>
		<SimpleData name="COM">Antofagasta</SimpleData>
		<SimpleData name="LOCALIDAD">Antofagasta Norte</SimpleData>
		<SimpleData name="ZONA">Z-CM</SimpleData>
		<SimpleData name="NOMBRE">Z-CM Zona de Cordón Montañoso</SimpleData>
		<SimpleData name="UPERM">Corresponde a una zona de características montañosas relacionada con la Cordillera de la Costa, localizada en el sector de pie de monte de la Portada Alto.</SimpleData>
		<SimpleData name="UPROH">No se permite ningún tipo de uso de suelo y edificaciones, salvo las complementarias al entorno natural, tales como miradores y senderos turísticos.</SimpleData>
		<SimpleData name="URL">http://www.observatoriourbano.cl/Ipt/cehu_resultado_decreto.asp?r=2&amp;c=4&amp;i=25</SimpleData>
		<SimpleData name="Capa">PRC Antofagasta</SimpleData>
		<SimpleData name="CUT">02101</SimpleData>
	</SchemaData></ExtendedData>
