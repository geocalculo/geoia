  <Placemark id="prc_antofagasta_mono.597">
	<Style><LineStyle><color>ff0000ff</color></LineStyle><PolyStyle><fill>0</fill></PolyStyle></Style>
	<ExtendedData><SchemaData schemaUrl="#prc_antofagasta_mono">
		<SimpleData name="REG">Antofagasta</SimpleData>
		<SimpleData name="COM">Antofagasta</SimpleData>
		<SimpleData name="LOCALIDAD">Antofagasta Norte</SimpleData>
		<SimpleData name="ZONA">ZED</SimpleData>
		<SimpleData name="NOMBRE">ZED Zona de Equipamiento Deportivo</SimpleData>
		<SimpleData name="UPERM">Equipamiento: deporte (autódromos y recintos destinados al deporte oactividad física en general) e instalaciones complementarias y comercio; áreas verdes y espacio público.</SimpleData>
		<SimpleData name="UPROH">Aquellos señalados en el art. 21 de la Ordenanza Local, además se prohibe todo tipo de vivienda, actividades productivas, edificaciones de infraestructura energética, sanitaria y de transporte; otros del D.O.publicado el 14-07-2012, Cuerpo I -20.</SimpleData>
		<SimpleData name="URL">http://www.observatoriourbano.cl/Ipt/cehu_resultado_decreto.asp?r=2&amp;c=4&amp;i=25</SimpleData>
		<SimpleData name="Capa">PRC Antofagasta</SimpleData>
		<SimpleData name="CUT">02101</SimpleData>
	</SchemaData></ExtendedData>
